DirectoryIndex index.html
Options -MultiViews
RewriteEngine On

# Normalizar las páginas conocidas sin barra final en un solo salto.
# La URL de destino siempre es HTTPS, sin www y con barra final.
RewriteRule ^(contacto|reformas-malaga|pintura-malaga|alisado-paredes-malaga|pladur-malaga)$ https://aravenareformas.es/$1/ [R=301,L,NE]

# URL antigua retirada: redirigir directamente a la página de pintura.
RewriteRule ^pintura-muebles-malaga/?$ https://aravenareformas.es/pintura-malaga/ [R=301,L,NE]

# Dominio canónico: eliminar www.
RewriteCond %{HTTP_HOST} !^aravenareformas\.es$ [NC]
RewriteRule ^ https://aravenareformas.es%{REQUEST_URI} [R=301,L,NE]

# Forzar HTTPS sin provocar bucles si el servidor termina TLS en un proxy.
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !^https$ [NC]
RewriteRule ^ https://aravenareformas.es%{REQUEST_URI} [R=301,L,NE]
