DirectoryIndex index.html
Options -MultiViews
RewriteEngine On

# Normalizar las páginas conocidas sin barra final en un solo salto.
# La URL de destino siempre es HTTPS y usa www.
RewriteRule ^(contacto|reformas-malaga|pintura-malaga|pintura-airless-malaga|alisado-paredes-malaga|pladur-malaga)$ https://www.aravenareformas.es/$1/ [R=301,L,NE]

# URL antigua retirada: redirigir directamente a la página de pintura.
RewriteRule ^pintura-muebles-malaga/?$ https://www.aravenareformas.es/pintura-malaga/ [R=301,L,NE]

# Dominio canónico: usar www.
RewriteCond %{HTTP_HOST} !^www\.aravenareformas\.es$ [NC]
RewriteRule ^ https://www.aravenareformas.es%{REQUEST_URI} [R=301,L,NE]

# Forzar HTTPS sin provocar bucles si el servidor termina TLS en un proxy.
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !^https$ [NC]
RewriteRule ^ https://www.aravenareformas.es%{REQUEST_URI} [R=301,L,NE]
